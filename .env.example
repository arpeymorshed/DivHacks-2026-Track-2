# Copy to .env.local and fill in team numbers locally in E.164 format.
# Own Number: personal sender numbers used to identify each person.
# Leave unused numbers empty. Never commit real phone numbers.
DEMO_ABHIMANYU_PHONE=""
DEMO_KASHISH_PHONE=""
DEMO_MUSAMMAT_PHONE=""
# Arpey is the landlord, not a tenant; excluded from tenant lookup.
DEMO_ARPEY_PHONE=""

# Texts On: Photon destination numbers that each person texts.
# These are bot destinations, not sender identities for tenant lookup.
DEMO_ABHIMANYU_PHOTON_NUMBER=""
DEMO_KASHISH_PHOTON_NUMBER=""
DEMO_MUSAMMAT_PHOTON_NUMBER=""
DEMO_ARPEY_PHOTON_NUMBER=""

# MongoDB Atlas: put actual connection values only in .env.local.
MONGODB_URI=
MONGODB_DB=

# Gemini: put the actual API key only in .env.local.
GEMINI_API_KEY=
